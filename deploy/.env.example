# ============================================================
# EC2 runtime environment for the HR Portal production stack.
# Copy to ".env" on the server (next to docker-compose.yml) and fill in.
# docker compose automatically loads this file. NEVER commit the real .env.
# ============================================================

# ---- Docker Hub image source (used by compose interpolation) ----
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# ---- Spring profile (prod = quieter logging; no prod override file needed) ----
SPRING_PROFILES_ACTIVE=prod

# ---- Database ----
# The app's JDBC URL uses createDatabaseIfNotExist=true, which needs the
# CREATE privilege, so it connects as MySQL root. DB_PASSWORD is therefore the
# MySQL root password. Use a long, random value.
DB_NAME=hr
DB_USER=root
DB_PASSWORD=CHANGE_ME_strong_db_root_password

# ---- JWT signing secret (REQUIRED) ----
# Generate one:  openssl rand -base64 48
APP_JWT_SECRET=CHANGE_ME_base64_random_secret

# ---- Twilio SMS (optional; leave disabled unless you have real credentials) ----
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Mail (optional; app does not send mail today, defaults are harmless) ----
MAIL_HOST=localhost
MAIL_PORT=1025
